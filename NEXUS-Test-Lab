522 |   document.getElementById('progressOut').textContent =
523 |     'Progress: ' + val + '%';
524 |   document.getElementById('progressOut').className =
525 |     'output' + (val === 100 ? ' glow-green' : ' glow-cyan');
526 |   track('click');
527 |   toast(val === 100 ? '✓ Complete!' : val + '% set');
528 | }
