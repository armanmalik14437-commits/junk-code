530 | /* === WORD COUNT === */
531 | function countWords() {
532 |   const val = document.getElementById('noteArea').value;
533 |   const words = val.trim() ? val.trim().split(/\s+/).length : 0;
534 |   const chars = val.length;
535 |   document.getElementById('wordOut').textContent =
536 |     'Words: ' + words + ' | Chars: ' + chars;
537 |   track('key');
538 | }
