540 | /* === THEME === */
541 | function setTheme(c) {
542 |   const colors = {
543 |     cyan:   '#00f5ff',
544 |     violet: '#bf00ff',
545 |     pink:   '#ff0080',
546 |     green:  '#00ff88',
547 |   };
548 |   document.documentElement.style.setProperty('--cyan', colors[c]);
549 |   document.getElementById('themeOut').textContent =
550 |     'Theme: ' + c + ' active';
551 |   document.getElementById('themeOut').className =
552 |     'output glow-' + c;
553 |   track('click');
554 |   toast('🎨 Theme: ' + c);
555 | }
556 | 
557 | /* === LIST === */
558 | function addItem() {
559 |   const val = document.getElementById('listIn').value.trim();
560 |   if (!val) { toast('Kuch likho!'); return; }
561 |   listItems.push(val);
562 |   document.getElementById('listIn').value = '';
563 |   renderList();
564 |   track('click');
565 |   toast('+ ' + val + ' added');
566 | }
567 | 
568 | function removeItem(i) {
569 |   listItems.splice(i, 1);
570 |   renderList();
571 |   track('click');
572 |   toast('✕ Item removed');
573 | }
574 | 
575 | function clearList() {
576 |   listItems = [];
577 |   renderList();
578 |   track('click');
579 |   toast('✕ List cleared');
580 | }
581 | 
582 | function renderList() {
583 |   const wrap = document.getElementById('listWrap');
584 |   const out  = document.getElementById('listOut');
585 |   wrap.innerHTML = '';
586 |   if (listItems.length === 0) {
587 |     out.textContent = 'List empty hai...';
588 |     out.className = 'output';
589 |     return;
590 |   }
591 |   listItems.forEach((item, i) => {
592 |     const div = document.createElement('div');
593 |     div.className = 'list-item';
594 |     div.innerHTML = `
595 |       <span class="color-dot"
596 |         style="background:var(--cyan)"></span>
597 |       <span style="flex:1">${item}</span>
598 |       <span style="color:var(--pink);cursor:pointer;font-size:0.8rem"
599 |         onclick="removeItem(${i})">✕</span>`;
600 |     wrap.appendChild(div);
601 |   }); |   out.textContent = listItems.length + ' items';
602 |   out.className = 'output glow-cyan';
603 | }
604 | 
605 | /* === KEYBOARD === */
