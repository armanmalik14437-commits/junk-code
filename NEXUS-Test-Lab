429 | /* === TOAST === */
430 | function toast(msg, color) {
431 |   const t = document.getElementById('toast');
432 |   t.textContent = msg;
433 |   t.style.borderColor = color || 'rgba(0,245,255,0.3)';
434 |   t.style.color = color ? color : 'var(--cyan)';
435 |   t.classList.add('show');
436 |   clearTimeout(window._t);
437 |   window._t = setTimeout(() => t.classList.remove('show'), 2000);
438 | }
439 | 
440 | /* === TRACK === */
441 | function track(type) {
442 |   if (type === 'click') {
443 |     clicks++;
444 |     document.getElementById('s1').textContent = clicks;
445 |   } else if (type === 'key') {
446 |     keys++;
447 |     document.getElementById('s2').textContent = keys;
448 |   }
449 |   actions++;
450 |   document.getElementById('s3').textContent = actions;
451 | }
