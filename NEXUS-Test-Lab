508 | /* === TAGS === */
509 | function selectTag(el, color) {
510 |   document.querySelectorAll('.tag')
510 |     .forEach(t => t.classList.remove('active'));
511 |   el.classList.add('active');
512 |   const out = document.getElementById('tagOut');
513 |   out.textContent = '✦ Selected: ' + el.textContent;
514 |   out.className = 'output glow-' + color;
515 |   track('click');
516 |   toast('✦ ' + el.textContent + ' selected');
517 | }
