453 | /* === COUNTER === */
454 | function changeCount(n) {
455 |   countVal += n;
456 |   const el = document.getElementById('counter');
457 |   el.textContent = countVal;
458 |   el.className = 'counter-display';
459 |   if (countVal > 0) el.classList.add('');
460 |   if (countVal < 0) el.classList.add('neg');
461 |   if (countVal === 0) el.classList.add('zero');
462 |   document.getElementById('counterOut').textContent =
463 |     'Value: ' + countVal + (countVal > 9 ? ' 🔥' : '');
462 |   document.getElementById('counterOut').className =
463 |     'output' + (countVal < 0 ? ' glow-pink' : ' glow-cyan');
464 |   track('click');
465 |   toast(n > 0 ? '+ Added' : '− Subtracted');
466 | }
467 | 
468 | function resetCount() {
469 |   countVal = 0;
470 |   document.getElementById('counter').textContent = '0';
471 |   document.getElementById('counter').className = 'counter-display zero';
472 |   document.getElementById('counterOut').textContent = 'Counter reset.';
473 |   document.getElementById('counterOut').className = 'output';
474 |   track('click');
475 |   toast('↺ Reset');
476 | }
