478 | /* === TEXT === */
479 | function processText() {
480 |   const val = document.getElementById('textIn').value.trim();
481 |   if (!val) { toast('Kuch likho pehle!'); return; }
482 |   const out = document.getElementById('textOut');
483 |   out.textContent = '▶ ' + val.toUpperCase() +
484 |     ' [' + val.length + ' chars]';
485 |   out.className = 'output glow-cyan';
486 |   track('click');
487 |   toast('✓ Processed');
488 | }
489 | 
490 | function reverseText() {
491 |   const val = document.getElementById('textIn').value.trim();
492 |   if (!val) { toast('Kuch likho pehle!'); return; }
493 |   const out = document.getElementById('textOut');
494 |   out.textContent = '⇄ ' + val.split('').reverse().join('');
495 |   out.className = 'output glow-violet';
496 |   track('click');
497 |   toast('⇄ Reversed');
498 | }
499 | 
500 | function clearText() {
501 |   document.getElementById('textIn').value = '';
502 |   document.getElementById('textOut').textContent = 'Cleared.';
503 |   document.getElementById('textOut').className = 'output';
504 |   track('click');
505 |   toast('✕ Cleared');
506 | }
